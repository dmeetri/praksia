# ============================
# PRAKSIA - Environment Config
# ============================
# Copy this file to .env and fill in your values

# --- PostgreSQL ---
POSTGRES_DB=praksia
POSTGRES_USER=praksia_user
POSTGRES_PASSWORD=your_very_strong_password_here

# --- Database URL (for Prisma) ---
DATABASE_URL=postgresql://praksia_user:your_very_strong_password_here@postgres:5432/praksia

# --- NextAuth ---
# Generate secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://praksia.ru

# --- Email (SMTP) ---
# Gmail example: use App Password (not your regular password)
# Enable 2FA in Google account, then create App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=Praksia <your_email@gmail.com>

# --- Admin ---
# Email of the first admin user (set during seed)
ADMIN_EMAIL=admin@praksia.ru

# --- App ---
NEXT_PUBLIC_APP_NAME=Praksia
NEXT_PUBLIC_APP_URL=http://praksia.ru
