# ============================
# PRAKSIA — Настройка окружения
# ============================
# Скопируйте этот файл в .env и заполните свои значения

# ─── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=praksia
POSTGRES_USER=praksia_user
POSTGRES_PASSWORD=your_strong_password_here

# ─── URL базы данных (для Prisma) ─────────────────────────────
# При запуске через docker-compose хост — "postgres" (имя сервиса)
DATABASE_URL=postgresql://praksia_user:your_strong_password_here@postgres:5432/praksia

# ─── NextAuth ─────────────────────────────────────────────────
# Сгенерируйте случайный секрет: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://praksia.ru

# ─── Timeweb Почта (SMTP) ─────────────────────────────────────
# MCP-сервер: https://api-mail.timeweb.com/mcp
# Настройки SMTP для почты Timeweb:
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=no-reply@praksia.ru
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=Praksia <no-reply@praksia.ru>

# ─── Администратор ────────────────────────────────────────────
# Email первого администратора (создаётся при первом запуске)
# Пароль по умолчанию: Admin123!@#  (смените после первого входа!)
ADMIN_EMAIL=admin@praksia.ru

# ─── Приложение ───────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Praksia
NEXT_PUBLIC_APP_URL=http://praksia.ru
